# Generate a unique random secret; never commit the real .env file.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_ENV=development

# Local SQLite default is used when DATABASE_URL is unset.
# Production example: postgresql://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_URL=

# Comma-separated exact browser origins only (no path and no trailing slash).
# Example for GitHub Pages:
# CORS_ORIGINS=https://veterinerakademiplatformu.github.io
# For cross-site cookie sessions over HTTPS, use SameSite=None and Secure=true.
CORS_ORIGINS=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Use a shared limiter store such as Redis for multi-worker production.
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
